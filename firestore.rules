rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // Default catch-all: Deny unknown root paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Store Config: Public read and write for store configuration
    match /store/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Products: Public read, write & delete
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Orders: Public create, read & update for status changes
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // Customers: User and customer account profiles
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Security & Intrusion logs (Honeypot protection system)
    match /threat_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Coupons
    match /coupons/{couponId} {
      allow read, write: if isValidId(couponId);
    }

    // Test connection probe
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

