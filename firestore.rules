rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Store Config: Public read and write for store configuration
    match /store/{docId} {
      allow read, write: if true;
    }

    // Products: Public read and catalogue management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: Public order placement, tracking and status updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customers: User and customer account profiles
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Security & Intrusion logs (Honeypot protection system)
    match /threat_logs/{logId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Test connection probe
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}


