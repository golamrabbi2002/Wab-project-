rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'golamrabbi4801@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.image is string && data.image.size() <= 2000;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 50 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    // Default catch-all: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Store Config: Public can read store profile, ONLY Admin can write
    match /store/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Public can read, ONLY Admin can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data) && isValidId(productId);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Orders: Anyone can create a valid order during checkout.
    // Read is restricted to the authenticated customer who placed it or an Admin.
    // Update/Delete is strictly restricted to Admins.
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data) && isValidId(orderId);
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() && isValidOrder(request.resource.data) && isValidId(orderId);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Customers: User can access own profile, Admin can access all
    match /customers/{customerId} {
      allow read, write: if (isSignedIn() && request.auth.uid == customerId && isValidCustomer(request.resource.data)) || isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable through secure backend or console
    }
  }
}
