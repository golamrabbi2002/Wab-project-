rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'golamrabbi4801@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isCustomerOwner(customerId) {
      return isSignedIn() && request.auth.uid == customerId;
    }

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin authorization documents
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Store Config: Public read and store updates
    match /store/{docId} {
      allow read, write: if true;
    }

    // Products: Public read for browsing, inventory and product catalog management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: Order placement, tracking by order ID, and order updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customers: User and customer account profiles
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Coupons: Promo voucher lookup and management
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Security & Intrusion logs (Honeypot telemetry)
    match /threat_logs/{logId} {
      allow read, write: if true;
    }

    // Connection health check test probe
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
