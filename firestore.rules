rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Store Config: Authenticated users can read and write store configuration
    match /store/{docId} {
      allow read, write: if request.auth != null;
    }

    // Products: Authenticated users can read and manage catalogue
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Orders: Authenticated users can read, create, track and update orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Customers: Authenticated user profiles and customer records
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // Security & Intrusion logs (Honeypot protection system)
    match /threat_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read, write: if request.auth != null;
    }

    // Test connection probe
    match /test/{testId} {
      allow read, write: if request.auth != null;
    }
  }
}

